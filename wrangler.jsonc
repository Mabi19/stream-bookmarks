/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "stream-bookmarks",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-06",
    "observability": {
        "enabled": true,
    },
    "upload_source_maps": true,
    "workers_dev": true,
    "preview_urls": true,
    "secrets": {
        "required": ["YOUTUBE_API_KEY"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "stream-bookmarks",
            "database_id": "5218042c-8562-4fed-9290-1da02c755618",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "182438a0ba1945fc88f9652be5ad7251",
        },
    ],
}
